{
  "name": "rclweb",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Browser TypeScript package for rclweb (R2WP client around the rclweb wasm core)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "files": [
    "src",
    "wasm",
    "README.md"
  ],
  "scripts": {
    "check": "bun build ./src/index.ts --target=browser --outdir=./dist",
    "test": "bun test",
    "build": "bun build ./src/index.ts --target=browser --outdir=./dist && bun build ./src/worker/io-worker.ts --target=browser --outdir=./dist/worker"
  }
}
