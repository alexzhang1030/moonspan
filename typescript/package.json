{
  "name": "rcl-web",
  "version": "0.0.5",
  "private": false,
  "license": "Apache-2.0",
  "description": "Browser TypeScript package for rclweb (R2WP client around the rclweb wasm core)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexzhang1030/rclweb.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/alexzhang1030/rclweb#readme",
  "bugs": {
    "url": "https://github.com/alexzhang1030/rclweb/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "rcl-web": "./dist/cli.js"
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "bun --bun tsdown",
    "test": "bun test",
    "build": "bun --bun tsdown",
    "prepack": "bun ../scripts/npm-pack.ts --stage && bun --bun tsdown"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  }
}
