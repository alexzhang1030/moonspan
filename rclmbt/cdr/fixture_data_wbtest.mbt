///|
test "cdr corpus bridge totals and frozen buckets" {
  assert_eq(cdr_corpus_fixtures.length(), CDR_FX_FIXTURE_TOTAL)
  assert_eq(cdr_corpus_comparisons.length(), CDR_FX_COMPARISON_TOTAL)
  assert_eq(cdr_fx_count(f => f.ros_distro == "humble"), CDR_FX_HUMBLE_TOTAL)
  assert_eq(cdr_fx_count(f => f.ros_distro == "jazzy"), CDR_FX_JAZZY_TOTAL)
  assert_eq(
    cdr_fx_count(f => f.serialized_endianness == "little"),
    CDR_FX_LITTLE_ENDIAN_TOTAL,
  )
  assert_eq(
    cdr_fx_count(f => f.serialized_endianness == "big"),
    CDR_FX_BIG_ENDIAN_TOTAL,
  )
  assert_eq(cdr_fx_count(f => f.support_row_id == "H-CY"), CDR_FX_ROW_H_CY)
  assert_eq(cdr_fx_count(f => f.support_row_id == "H-FT"), CDR_FX_ROW_H_FT)
  assert_eq(cdr_fx_count(f => f.support_row_id == "H-ZN"), CDR_FX_ROW_H_ZN)
  assert_eq(cdr_fx_count(f => f.support_row_id == "J-CY"), CDR_FX_ROW_J_CY)
  assert_eq(cdr_fx_count(f => f.support_row_id == "J-FT"), CDR_FX_ROW_J_FT)
  assert_eq(cdr_fx_count(f => f.support_row_id == "J-ZN"), CDR_FX_ROW_J_ZN)
  assert_eq(cdr_fx_count(f => f.zero_tail_bytes == 0), CDR_FX_EXACT_TAIL_TOTAL)
  assert_eq(
    cdr_fx_count(f => f.zero_tail_bytes == 4),
    CDR_FX_FOUR_BYTE_TAIL_TOTAL,
  )
  assert_eq(
    cdr_fx_count(f => f.zero_tail_bytes == 12),
    CDR_FX_TWELVE_BYTE_TAIL_TOTAL,
  )
}

///|
test "cdr corpus binaries reconstruct length and fingerprint" {
  for f in cdr_corpus_fixtures {
    let bytes = cdr_fx_decode_hex(f.hex_bytes)
    assert_eq(bytes.length(), f.byte_length)
    assert_eq(cdr_fx_fingerprint_hex(bytes), f.fingerprint_hex)
    assert_eq(f.serialized_sha256.length(), 64)
    assert_eq(f.hex_bytes.length(), f.byte_length * 2)
    assert_eq(f.type_name.length() > 0, true)
    assert_eq(f.canonical_prefix_sha256.length(), 64)
  }
}

///|
test "cdr corpus open_default endianness matches metadata" {
  for f in cdr_corpus_fixtures {
    let arr = cdr_fx_decode_hex(f.hex_bytes)
    let view = cdr_fx_bytes_of(arr)[:]
    match CdrReader::open_default(view) {
      Ok(reader) =>
        if f.serialized_endianness == "little" {
          assert_eq(reader.little_endian(), true)
        } else if f.serialized_endianness == "big" {
          assert_eq(reader.little_endian(), false)
        } else {
          abort("unexpected endianness metadata")
        }
      Err(e) => abort("open_default failed: " + e.code + " for " + f.id)
    }
  }
}

///|
test "cdr corpus logical length plus zero tail equals byte length" {
  for f in cdr_corpus_fixtures {
    assert_eq(f.logical_byte_length + f.zero_tail_bytes, f.byte_length)
    let bytes = cdr_fx_decode_hex(f.hex_bytes)
    let mut i = f.logical_byte_length
    while i < bytes.length() {
      assert_eq(bytes[i], b'\x00')
      i = i + 1
    }
  }
}

///|
test "cdr corpus canonical prefixes match logical slices" {
  for f in cdr_corpus_fixtures {
    let canon = cdr_fx_find(f.canonical_fixture_id)
    assert_eq(canon.zero_tail_bytes, 0)
    assert_eq(canon.byte_length, f.logical_byte_length)
    assert_eq(canon.serialized_sha256, f.canonical_prefix_sha256)
    let bytes = cdr_fx_decode_hex(f.hex_bytes)
    let canon_bytes = cdr_fx_decode_hex(canon.hex_bytes)
    assert_eq(cdr_fx_prefix_eq(bytes, canon_bytes, f.logical_byte_length), true)
  }
}

///|
test "cdr corpus multi-row comparison identities and big-endian singletons" {
  assert_eq(cdr_corpus_comparisons.length(), CDR_FX_COMPARISON_TOTAL)
  for c in cdr_corpus_comparisons {
    assert_eq(c.fixture_ids.length() >= 2, true)
    assert_eq(c.rows.length(), c.fixture_ids.length())
    let first = cdr_fx_find(c.fixture_ids[0])
    assert_eq(first.case_id, c.case_id)
    assert_eq(first.ros_distro, c.ros_distro)
    assert_eq(first.type_name.length() > 0, true)
    let mut i = 0
    while i < c.fixture_ids.length() {
      let f = cdr_fx_find(c.fixture_ids[i])
      assert_eq(f.case_id, c.case_id)
      assert_eq(f.ros_distro, c.ros_distro)
      assert_eq(f.type_name, first.type_name)
      assert_eq(f.semantic_value_sha256, first.semantic_value_sha256)
      assert_eq(f.schema_identity.scheme, first.schema_identity.scheme)
      assert_eq(f.schema_identity.value, first.schema_identity.value)
      i = i + 1
    }
  }
  // Singleton groups are exactly the two big-endian primitive fixtures.
  let mut big_singletons = 0
  for f in cdr_corpus_fixtures {
    if f.serialized_endianness == "big" {
      let mut peers = 0
      for g in cdr_corpus_fixtures {
        if g.case_id == f.case_id && g.ros_distro == f.ros_distro {
          peers = peers + 1
        }
      }
      assert_eq(peers, 1)
      big_singletons = big_singletons + 1
    }
  }
  assert_eq(big_singletons, CDR_FX_SINGLETON_BIG_ENDIAN_TOTAL)
  assert_eq(
    CDR_FX_COMPARISON_TOTAL + CDR_FX_SINGLETON_BIG_ENDIAN_TOTAL,
    CDR_FX_GROUP_TOTAL,
  )
}
