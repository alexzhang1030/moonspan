///|
fn cdr_fx_hex_nibble(code : Int) -> Int {
  if code >= 48 && code <= 57 {
    code - 48
  } else if code >= 97 && code <= 102 {
    code - 97 + 10
  } else {
    abort("bad hex nibble")
  }
}

///|
fn cdr_fx_decode_hex(hex : String) -> Array[Byte] {
  let n = hex.length()
  if n % 2 != 0 {
    abort("odd hex length")
  }
  let out : Array[Byte] = []
  let mut i = 0
  while i < n {
    let hi = cdr_fx_hex_nibble(hex[i].to_int())
    let lo = cdr_fx_hex_nibble(hex[i + 1].to_int())
    out.push(((hi << 4) | lo).to_byte())
    i = i + 2
  }
  out
}

///|
fn cdr_fx_fingerprint_u64(bytes : Array[Byte]) -> UInt64 {
  let mut hash : UInt64 = 0xcbf29ce484222325UL
  let prime : UInt64 = 0x100000001b3UL
  for b in bytes {
    hash = (hash ^ b.to_uint64()) * prime
  }
  hash
}

///|
fn cdr_fx_nibble_char(n : Int) -> Char {
  if n < 10 {
    (48 + n).unsafe_to_char()
  } else {
    (87 + n).unsafe_to_char()
  }
}

///|
fn cdr_fx_u64_to_hex16(v : UInt64) -> String {
  let mut out = ""
  let mut i = 0
  while i < 16 {
    let shift = (15 - i) * 4
    let nib = ((v >> shift) & 0xfUL).to_int()
    out = out + cdr_fx_nibble_char(nib).to_string()
    i = i + 1
  }
  out
}

///|
fn cdr_fx_fingerprint_hex(bytes : Array[Byte]) -> String {
  cdr_fx_u64_to_hex16(cdr_fx_fingerprint_u64(bytes))
}

///|
fn cdr_fx_bytes_of(arr : Array[Byte]) -> Bytes {
  Bytes::from_array(arr[:])
}

///|
fn cdr_fx_find(id : String) -> CdrCorpusFixture {
  for f in cdr_corpus_fixtures {
    if f.id == id {
      return f
    }
  }
  abort("fixture id not found: " + id)
}

///|
fn cdr_fx_prefix_eq(a : Array[Byte], b : Array[Byte], n : Int) -> Bool {
  if a.length() < n || b.length() < n {
    return false
  }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn cdr_fx_count(pred : (CdrCorpusFixture) -> Bool) -> Int {
  let mut n = 0
  for f in cdr_corpus_fixtures {
    if pred(f) {
      n = n + 1
    }
  }
  n
}

