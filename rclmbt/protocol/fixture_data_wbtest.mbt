// protocol: r2wp-v0
// sources: protocol/testdata/manifest.json, protocol/testdata/malformed/manifest.json
//
// White-box fixture bridge for M0-03g1: reconstructs committed R2WP
// valid/boundary and malformed binaries from compact raw-hex + repeat
// chunks, validates length and FNV-1a fingerprint, and keeps the 64 MiB
// segment recipe as a descriptor with metadata-only validation.

///|
priv enum ByteChunk {
  Raw(String)
  Rep(String, Int)
}

///|
priv struct FrameDecoderContext {
  selected_version : Int
  experimental_opcodes_enabled : Bool
  available_clock_ids : Array[Int]
}

