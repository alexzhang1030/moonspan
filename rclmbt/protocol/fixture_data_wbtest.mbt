  decoder_context : FrameDecoderContext?
}

///|
fn hex_nibble(code : Int) -> Int {
  if code >= 48 && code <= 57 {
    code - 48
  } else if code >= 97 && code <= 102 {
    code - 97 + 10
  } else {
    abort("bad hex nibble")
  }
}

///|
fn decode_hex(hex : String) -> Array[Byte] {
  let n = hex.length()
  if n % 2 != 0 {
    abort("odd hex length")
  }
  let out : Array[Byte] = []
  let mut i = 0
  while i < n {
    let hi = hex_nibble(hex[i].to_int())
    let lo = hex_nibble(hex[i + 1].to_int())
    out.push(((hi << 4) | lo).to_byte())
    i = i + 2
  }
  out
}

///|
fn expand_chunks(chunks : Array[ByteChunk]) -> Array[Byte] {
  let out : Array[Byte] = []
  for chunk in chunks {
    match chunk {
      Raw(h) => {
        let b = decode_hex(h)
        for x in b {
          out.push(x)
        }
      }
      Rep(h, count) => {
        let pat = decode_hex(h)
        let mut c = 0
        while c < count {
          for x in pat {
            out.push(x)
          }
          c = c + 1
        }
      }
    }
  }
  out
}

///|
fn fingerprint_u64(bytes : Array[Byte]) -> UInt64 {
  let mut hash : UInt64 = 0xcbf29ce484222325UL
  let prime : UInt64 = 0x100000001b3UL
  for b in bytes {
    hash = (hash ^ b.to_uint64()) * prime
  }
  hash
}

///|
fn nibble_char(n : Int) -> Char {
  if n < 10 {
    (48 + n).unsafe_to_char()
  } else {
    (87 + n).unsafe_to_char()
  }
}

///|
fn u64_to_hex16(v : UInt64) -> String {
  let mut out = ""
  let mut i = 0
  while i < 16 {
    let shift = (15 - i) * 4
    let nib = ((v >> shift) & 0xfUL).to_int()
    out = out + nibble_char(nib).to_string()
    i = i + 1
  }
  out
}

///|
fn fingerprint_hex(bytes : Array[Byte]) -> String {
  u64_to_hex16(fingerprint_u64(bytes))
}

///|
fn recipe_fingerprint(recipe : RecipeDescriptor) -> String {
  // Same field join as the Bun generator (UTF-8 of the joined text).
  let text = recipe.pattern_hex +
    "|" +
    recipe.length.to_string() +
    "|" +
    recipe.opcode.to_string() +
    "|" +
    recipe.channel_id.to_string() +
    "|" +
    recipe.sequence.to_string() +
    "|" +
    recipe.priority.to_string() +
    "|" +
    recipe.clock_id.to_string()
  let bytes : Array[Byte] = []
  let mut i = 0
  while i < text.length() {
    // ASCII-only join text.
    bytes.push(text[i].to_int().to_byte())
    i = i + 1
  }
  fingerprint_hex(bytes)
}

///|
fn clocks_key(ids : Array[Int]) -> String {
  let mut out = ""
  let mut i = 0
  while i < ids.length() {
    if i > 0 {
      out = out + ","
    }
    out = out + ids[i].to_string()
    i = i + 1
  }
  out
}

