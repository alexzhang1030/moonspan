///|
fn count_where(pred : (BridgeFixture) -> Bool) -> Int {
  let mut n = 0
  for f in bridge_fixtures {
    if pred(f) {
      n = n + 1
    }
  }
  n
}

test "bridge totals and splits" {
  assert_eq(bridge_fixtures.length(), VALID_TOTAL + MALFORMED_TOTAL)
  assert_eq(count_where(f => f.corpus == "valid"), VALID_TOTAL)
  assert_eq(count_where(f => f.corpus == "malformed"), MALFORMED_TOTAL)
  assert_eq(count_where(f => f.corpus == "valid" && f.kind == "bootstrap"), VALID_BOOTSTRAP)
  assert_eq(count_where(f => f.corpus == "valid" && f.kind == "frame" && f.representation == "binary"), VALID_FRAME_BINARY)
  assert_eq(count_where(f => f.representation == "segment_recipe"), VALID_SEGMENT_RECIPE)
  assert_eq(count_where(f => f.corpus == "malformed" && f.kind == "bootstrap"), MALFORMED_BOOTSTRAP)
  assert_eq(count_where(f => f.corpus == "malformed" && f.kind == "frame"), MALFORMED_FRAME)
  assert_eq(count_where(f => f.representation == "binary"), MATERIALIZED_BINARY_TOTAL)
}

test "materialized binaries reconstruct length and fingerprint" {
  let mut seen = 0
  for f in bridge_fixtures {
    match f.body {
      Binary(chunks) => {
        let bytes = expand_chunks(chunks)
        assert_eq(bytes.length(), f.byte_length)
        assert_eq(fingerprint_hex(bytes), f.fingerprint_hex)
        assert_eq(f.source_sha256.length(), 64)
        seen = seen + 1
      }
      SegmentRecipe(_) => ()
    }
  }
  assert_eq(seen, MATERIALIZED_BINARY_TOTAL)
}

test "segment recipe descriptor exact metadata" {
  let mut found = 0
  for f in bridge_fixtures {
    match f.body {
      SegmentRecipe(recipe) => {
        assert_eq(f.id, "frame-app-payload-64mib-recipe")
        assert_eq(f.representation, "segment_recipe")
        assert_eq(f.byte_length, 67108896)
        assert_eq(recipe.length, 67108864)
        assert_eq(recipe.pattern_hex, "a55a")
        assert_eq(recipe.opcode, 2)
        assert_eq(recipe.channel_id, 13)
        assert_eq(recipe.sequence, 0)
        assert_eq(recipe.priority, 2)
        assert_eq(recipe.clock_id, 0)
        assert_eq(f.source_sha256, "2c62aac0b2979ca2cb898e05222295c0758acf6473cbaeebd9da04c859978bd5")
        assert_eq(recipe_fingerprint(recipe), f.fingerprint_hex)
        found = found + 1
      }
      Binary(_) => ()
    }
  }
  assert_eq(found, VALID_SEGMENT_RECIPE)
}

test "malformed oracles exact planes codes and steps" {
  let mut bootstrap_n = 0
  let mut selected_n = 0
  for f in bridge_fixtures {
    if f.corpus == "malformed" {
      match f.oracle {
        Some(o) => {
          assert_eq(o.code >= 1, true)
          assert_eq(o.name.length() > 0, true)
          assert_eq(o.reason.length() > 0, true)
          assert_eq(o.offset >= 0, true)
          if o.plane == "bootstrap" {
            assert_eq(o.step >= 1, true)
            assert_eq(o.step <= 9, true)
            bootstrap_n = bootstrap_n + 1
          } else if o.plane == "selected_frame" {
            assert_eq(o.step >= 1, true)
            assert_eq(o.step <= 16, true)
            selected_n = selected_n + 1
          } else {
            abort("unexpected oracle plane")
          }
        }
        None => abort("malformed fixture missing oracle")
      }
    }
  }
  assert_eq(bootstrap_n, ORACLE_BOOTSTRAP_COUNT)
  assert_eq(selected_n, ORACLE_SELECTED_FRAME_COUNT)
  assert_eq(bootstrap_n + selected_n, MALFORMED_TOTAL)
}

test "frame decoder context exact distribution" {
  let mut frames = 0
  let mut narrow = 0
  let mut defaults = 0
  for f in bridge_fixtures {
    if f.kind == "frame" {
      match f.decoder_context {
        Some(ctx) => {
          assert_eq(ctx.selected_version, 0)
          assert_eq(ctx.experimental_opcodes_enabled, false)
          let key = clocks_key(ctx.available_clock_ids)
          if key == "0,1" {
            narrow = narrow + 1
          } else if key == "0,1,2,3,4" {
            defaults = defaults + 1
          } else {
            abort("unexpected available_clock_ids")
          }
          frames = frames + 1
        }
        None => abort("frame fixture missing decoder context")
      }
    }
  }
  assert_eq(frames, FRAME_TOTAL)
  assert_eq(narrow, FRAME_NARROW_CLOCK_COUNT)
  assert_eq(defaults, FRAME_DEFAULT_CLOCK_COUNT)
}
