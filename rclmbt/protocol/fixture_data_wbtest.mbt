}

///|
priv struct RecipeDescriptor {
  pattern_hex : String
  length : Int
  opcode : Int
  channel_id : Int
  sequence : Int
  priority : Int
  clock_id : Int
}

///|
priv enum FixtureBody {
  Binary(Array[ByteChunk])
  SegmentRecipe(RecipeDescriptor)
}

///|
priv struct BridgeFixture {
  id : String
