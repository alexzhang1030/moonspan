<?xml version="1.0"?>
<package format="3">
  <name>rclweb_cdr_interfaces</name>
  <version>0.0.0</version>
  <description>Deterministic ROS interfaces for the rclweb CDR corpus.</description>
  <maintainer email="maintainers@localhost">rclweb maintainers</maintainer>
  <license>LicenseRef-Pending-D06</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>builtin_interfaces</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
