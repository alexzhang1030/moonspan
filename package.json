{
  "name": "moonspan",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "workspaces": [
    "sdk/*",
    "examples/*"
  ],
  "scripts": {
    "docs:check": "bun run scripts/docs-check.ts",
    "test:docs": "bun test scripts/docs-check.test.ts",
    "test": "bun test",
    "check": "bun run docs:check && bun run test:docs"
  }
}
